# Atalhos de endereço. A área do aluno mora em /aulas; /academy leva para lá.
/academy        /aulas        301
/academy/*      /aulas        301

# Entrar: a página decide a tela pela conta (equipe vai ao painel; aluno, às aulas).
/login          /login            200

