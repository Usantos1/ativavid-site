# Cloudflare Pages. A zona ativavid.com impõe 4 h de cache ao navegador e
# fica com o MAIOR entre ela e o que está aqui: o HTML (no-cache) a zona
# respeita; CSS e JS acabam com 4 h, por isso continuam com ?v= na URL.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/
  Cache-Control: no-cache
  Link: </llms.txt>; rel="alternate"; type="text/markdown", </.well-known/ai-catalog.json>; rel="ai-catalog"

/index.html
  Cache-Control: no-cache

/*.css
  Cache-Control: public, max-age=300, must-revalidate

/*.js
  Cache-Control: public, max-age=300, must-revalidate

# Fontes e imagens: arquivo com o mesmo nome nunca muda de conteúdo. Imagem
# nova ganha nome novo (ex.: ui-editor-1600.webp), nunca sobrescreve.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/.well-known/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *
